.ipynb_checkpoints/
__pycache__/
.DS_Store

# Belt and braces. These folders are meant to sit beside the repository rather than
# inside it, so if one ever gets moved in by accident git still refuses to take it.
recordings/
models/
cache/
vendor/
_to_delete/

# The reference folder is a mixed bag, so we split it. The two papers are public and
# anyone can download them again, so 36 MB of pdf stays out of git. The dataset
# manifest is only 104 KB and it records exactly which sequences we were looking at,
# so that one is worth versioning and it is not excluded here.
reference/*.pdf

# Virtual environments never belong in here.
venv/
.venv/
